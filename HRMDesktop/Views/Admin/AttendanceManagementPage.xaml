<Page x:Class="HRMDesktop.Views.Admin.AttendanceManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Quản lý chấm công" Style="{StaticResource PageTitle}"/><TextBlock Text="Theo dõi bảng công theo ngày và xử lý yêu cầu điều chỉnh của nhân viên." Style="{StaticResource PageSubtitle}"/></StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Đã chấm công" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CheckedText" FontSize="23" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Đang làm việc" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WorkingText" FontSize="23" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Vắng / chưa chấm" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MissingText" FontSize="23" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Yêu cầu chờ duyệt" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PendingAdjustmentText" FontSize="23" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" TextChanged="Filter_Changed" ToolTip="Tìm tên hoặc mã nhân viên"/>
                <ComboBox x:Name="DepartmentFilter" Grid.Column="1" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Tất cả phòng ban"/><ComboBoxItem Content="Công nghệ thông tin"/><ComboBoxItem Content="Nhân sự"/><ComboBoxItem Content="Marketing"/><ComboBoxItem Content="Kinh doanh"/><ComboBoxItem Content="Tài chính"/></ComboBox>
                <DatePicker x:Name="WorkDatePicker" Grid.Column="2" Margin="12,0,0,0" SelectedDateChanged="Filter_Changed"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="10">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Bảng chấm công">
                    <DataGrid x:Name="AttendanceGrid" Margin="4,14,4,4">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NHÂN VIÊN" CellTemplate="{StaticResource EmployeeIdentityTemplate}" Width="1.25*"/>
                            <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding Department}" Width="1.05*"/>
                            <DataGridTextColumn Header="GIỜ VÀO" Binding="{Binding CheckIn}" Width="0.65*"/>
                            <DataGridTextColumn Header="GIỜ RA" Binding="{Binding CheckOut}" Width="0.65*"/>
                            <DataGridTextColumn Header="THỜI GIAN LÀM" Binding="{Binding WorkDurationDisplay}" Width="1.05*"/>
                            <DataGridTextColumn Header="KẾT QUẢ" Binding="{Binding AttendanceResult}" Width="1.05*"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="1.05*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Yêu cầu điều chỉnh">
                    <DataGrid x:Name="AdjustmentGrid" Margin="4,14,4,4">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NHÂN VIÊN" CellTemplate="{StaticResource EmployeeIdentityTemplate}" Width="1.25*"/>
                            <DataGridTextColumn Header="NGÀY" Binding="{Binding WorkDateDisplay}" Width="0.75*"/>
                            <DataGridTextColumn Header="GIỜ ĐỀ XUẤT" Binding="{Binding RequestedTimeDisplay}" Width="1*"/>
                            <DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="1.45*"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="0.85*"/>
                            <DataGridTemplateColumn Header="XỬ LÝ" Width="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Duyệt" Style="{StaticResource PrimaryButton}" Padding="10,6" Tag="{Binding}" IsEnabled="{Binding CanReview}" Click="ApproveAdjustment_Click"/><Button Content="Từ chối" Style="{StaticResource DangerButton}" Padding="10,6" Margin="7,0,0,0" Tag="{Binding}" IsEnabled="{Binding CanReview}" Click="RejectAdjustment_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
