<Page x:Class="HRMDesktop.Views.Admin.AttendanceManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Quản lý chấm công" Style="{StaticResource PageTitle}"/><TextBlock Text="Theo dõi bảng công theo ngày và xử lý yêu cầu điều chỉnh của nhân viên." Style="{StaticResource PageSubtitle}"/></StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Đã chấm công" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CheckedText" FontSize="23" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Đang làm việc" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WorkingText" FontSize="23" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Vắng / chưa chấm" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MissingText" FontSize="23" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Yêu cầu chờ duyệt" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PendingAdjustmentText" FontSize="23" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" TextChanged="Filter_Changed" ToolTip="Tìm tên hoặc mã nhân viên"/>
                <ComboBox x:Name="DepartmentFilter" Grid.Column="1" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Tất cả phòng ban"/><ComboBoxItem Content="Công nghệ thông tin"/><ComboBoxItem Content="Nhân sự"/><ComboBoxItem Content="Marketing"/><ComboBoxItem Content="Kinh doanh"/><ComboBoxItem Content="Tài chính"/></ComboBox>
                <DatePicker x:Name="WorkDatePicker" Grid.Column="2" Margin="12,0,0,0" SelectedDateChanged="Filter_Changed"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="10">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Bảng chấm công">
                    <DataGrid x:Name="AttendanceGrid" Margin="4,14,4,4">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NHÂN VIÊN" CellTemplate="{StaticResource EmployeeIdentityTemplate}" Width="1.25*"/>
                            <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding Department}" Width="1.05*"/>
                            <DataGridTextColumn Header="GIỜ VÀO" Binding="{Binding CheckIn}" Width="0.65*"/>
                            <DataGridTextColumn Header="GIỜ RA" Binding="{Binding CheckOut}" Width="0.65*"/>
                            <DataGridTextColumn Header="THỜI GIAN LÀM" Binding="{Binding WorkDurationDisplay}" Width="1.05*"/>
                            <DataGridTextColumn Header="KẾT QUẢ" Binding="{Binding AttendanceResult}" Width="1.05*"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="1.05*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Yêu cầu điều chỉnh">
                    <DataGrid x:Name="AdjustmentGrid" Margin="4,14,4,4">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NHÂN VIÊN" CellTemplate="{StaticResource EmployeeIdentityTemplate}" Width="1.25*"/>
                            <DataGridTextColumn Header="NGÀY" Binding="{Binding WorkDateDisplay}" Width="0.75*"/>
                            <DataGridTextColumn Header="GIỜ ĐỀ XUẤT" Binding="{Binding RequestedTimeDisplay}" Width="1*"/>
                            <DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="1.45*"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="0.85*"/>
                            <DataGridTemplateColumn Header="XỬ LÝ" Width="245"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Chi tiết" Style="{StaticResource SecondaryButton}" Padding="10,6" Tag="{Binding}" Click="ViewAdjustmentDetails_Click"/><Button Content="Duyệt" Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="7,0,0,0" Tag="{Binding}" IsEnabled="{Binding CanReview}" Click="ApproveAdjustment_Click"/><Button Content="Từ chối" Style="{StaticResource DangerButton}" Padding="10,6" Margin="7,0,0,0" Tag="{Binding}" IsEnabled="{Binding CanReview}" Click="RejectAdjustment_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid x:Name="AdjustmentDetailOverlay" Grid.RowSpan="4" Panel.ZIndex="30" Background="#990F172A" Visibility="Collapsed">
            <Border Width="590" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid><StackPanel><TextBlock Text="Chi tiết yêu cầu điều chỉnh" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="AdjustmentDetailEmployeeText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Content="×" Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" FontSize="20" HorizontalAlignment="Right" Click="CloseAdjustmentDetails_Click"/></Grid>
                    <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ngày điều chỉnh" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AdjustmentDetailDateText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Trạng thái" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AdjustmentDetailStatusText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#FFF7E6" CornerRadius="5" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Dữ liệu hiện tại" Foreground="#92400E"/><TextBlock x:Name="AdjustmentDetailOriginalText" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#EAF5F3" CornerRadius="5" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="Giờ đề xuất" Foreground="#115E59"/><TextBlock x:Name="AdjustmentDetailRequestedText" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border></Grid>
                    <Border Background="#F8FAFC" CornerRadius="5" Padding="14" Margin="0,18,0,0"><StackPanel><TextBlock Text="Lý do điều chỉnh" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AdjustmentDetailReasonText" TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,0"/></StackPanel></Border>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Gửi lúc" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AdjustmentDetailSubmittedText" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Thông tin xử lý" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AdjustmentDetailReviewedText" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid>
                    <Button Content="Đóng" Style="{StaticResource SecondaryButton}" Width="100" HorizontalAlignment="Right" Margin="0,24,0,0" Click="CloseAdjustmentDetails_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
