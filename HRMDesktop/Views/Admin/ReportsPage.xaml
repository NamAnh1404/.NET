<Page x:Class="HRMDesktop.Views.Admin.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
        <TextBlock Text="Báo cáo thống kê" Style="{StaticResource PageTitle}"/><TextBlock Text="Tổng hợp các chỉ số nhân sự quan trọng." Style="{StaticResource PageSubtitle}"/>
        <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Cơ cấu phòng ban" FontSize="17" FontWeight="SemiBold"/><StackPanel x:Name="DepartmentBars" Margin="0,20,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="Tình hình tháng hiện tại" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tổng quỹ lương" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PayrollText" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Đơn chờ duyệt" Foreground="{StaticResource MutedBrush}" Margin="0,28,0,0"/><TextBlock x:Name="LeaveText" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Tỷ lệ có mặt" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AttendanceText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/><TextBlock Text="Phòng ban hoạt động" Foreground="{StaticResource MutedBrush}" Margin="0,28,0,0"/><TextBlock x:Name="DepartmentCountText" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/></StackPanel></Grid></StackPanel></Border>
        </Grid>
    </StackPanel></ScrollViewer>
</Page>
