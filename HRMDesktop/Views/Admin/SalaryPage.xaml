<Page x:Class="HRMDesktop.Views.Admin.SalaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Lương và thưởng" Style="{StaticResource PageTitle}"/><TextBlock Text="Tạo phiếu, đối chiếu chấm công và xác nhận thanh toán theo tháng." Style="{StaticResource PageSubtitle}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Tạo bảng lương" Style="{StaticResource SecondaryButton}" Click="GeneratePayroll_Click"/><Button Content="Tính lại chấm công" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RecalculatePayroll_Click"/><Button Content="Sửa phiếu" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditSalary_Click"/><Button Content="Xác nhận thanh toán" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="PaySelected_Click"/></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Tổng phải trả" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalPayrollText" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="Tổng thưởng" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalBonusText" Foreground="#2563EB" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="Chờ thanh toán" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PendingText" Foreground="#D97706" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,18,0,0"><Grid><TextBlock x:Name="SalaryPeriodTitle" Text="Bảng lương tháng hiện tại" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="MonthFilter" Width="170" HorizontalAlignment="Right" SelectionChanged="MonthFilter_Changed"/></Grid></Border>
        <DataGrid x:Name="SalaryGrid" Grid.Row="3" Margin="0,18,0,0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="NHÂN VIÊN" CellTemplate="{StaticResource EmployeeIdentityTemplate}" Width="1.3*"/>
                <DataGridTextColumn Header="THÁNG" Binding="{Binding Month}" Width="0.65*"/>
                <DataGridTextColumn Header="LƯƠNG CƠ BẢN" Binding="{Binding BaseSalaryDisplay}" Width="1.05*"/>
                <DataGridTextColumn Header="THƯỞNG" Binding="{Binding BonusDisplay}" Width="0.9*"/>
                <DataGridTextColumn Header="KHẤU TRỪ" Binding="{Binding DeductionDisplay}" Width="0.9*"/>
                <DataGridTextColumn Header="THỰC NHẬN" Binding="{Binding NetSalaryDisplay}" Width="1.05*"/>
                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid x:Name="SalaryFormOverlay" Grid.RowSpan="4" Panel.ZIndex="20" Background="#990F172A" Visibility="Collapsed">
            <Border Width="470" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid><StackPanel><TextBlock Text="Cập nhật phiếu lương" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SalaryEmployeeText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Content="×" Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" FontSize="20" HorizontalAlignment="Right" Click="CancelSalaryEdit_Click"/></Grid>
                    <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Thưởng" FontWeight="SemiBold"/><TextBox x:Name="BonusBox" Style="{StaticResource Input}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Khấu trừ" FontWeight="SemiBold"/><TextBox x:Name="DeductionBox" Style="{StaticResource Input}" Margin="0,7,0,0"/></StackPanel></Grid>
                    <Border Background="#F0F7F6" CornerRadius="5" Padding="13" Margin="0,14,0,0"><Grid><TextBlock x:Name="PayrollSuggestionText" Foreground="#115E59" TextWrapping="Wrap" Margin="0,0,112,0"/><Button Content="Dùng đề xuất" Style="{StaticResource SecondaryButton}" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ApplySuggestedDeduction_Click"/></Grid></Border>
                    <TextBlock x:Name="SalaryFormError" Foreground="#DC2626" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="Hủy" Style="{StaticResource SecondaryButton}" Width="88" Click="CancelSalaryEdit_Click"/><Button Content="Lưu thay đổi" Style="{StaticResource PrimaryButton}" Width="125" Margin="9,0,0,0" Click="SaveSalaryEdit_Click"/></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
