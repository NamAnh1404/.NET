<Page x:Class="HRMDesktop.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock x:Name="WelcomeText" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="Metric1Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric1Value" FontSize="25" FontWeight="Bold" Margin="0,10,0,5"/><TextBlock x:Name="Metric1Note" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,7,0"><StackPanel><TextBlock x:Name="Metric2Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric2Value" FontSize="25" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,5"/><TextBlock x:Name="Metric2Note" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,3,0"><StackPanel><TextBlock x:Name="Metric3Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric3Value" FontSize="25" FontWeight="Bold" Foreground="#2563EB" Margin="0,10,0,5"/><TextBlock x:Name="Metric3Note" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock x:Name="Metric4Label" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Metric4Value" FontSize="25" FontWeight="Bold" Foreground="#D97706" Margin="0,10,0,5"/><TextBlock x:Name="Metric4Note" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" Text="Hoạt động gần đây" FontSize="17" FontWeight="SemiBold"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,16,0,0" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0" Height="44">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="NHÂN VIÊN" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="NGÀY" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="VÀO" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="RA" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer Height="274" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RecentList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="14,10" MinHeight="62">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="34" Height="34" CornerRadius="17" Background="#DDF4F0" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Initial}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding DisplayCode}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding WorkDateDisplay}" Foreground="#475569" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding CheckIn}" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding CheckOut}" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="4" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Đang làm việc"><Setter Property="Background" Value="#DDF4F0"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Đã kết thúc"><Setter Property="Background" Value="#E8EEF9"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Chưa chấm công"><Setter Property="Background" Value="#FFF4DE"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#475569"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Đang làm việc"><Setter Property="Foreground" Value="#0F766E"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Đã kết thúc"><Setter Property="Foreground" Value="#31589B"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Chưa chấm công"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Cần xử lý" FontSize="17" FontWeight="SemiBold"/>
                        <Border Background="#FFF7E6" CornerRadius="5" Padding="14" Margin="0,18,0,0"><StackPanel><TextBlock x:Name="PendingLeaveLabel" Text="Đơn nghỉ phép chờ duyệt" Foreground="#92400E"/><TextBlock x:Name="PendingLeaveText" Text="0 đơn" FontSize="20" FontWeight="Bold" Foreground="#B45309" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Background="#EAF5F3" CornerRadius="5" Padding="14" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="OnlineLabel" Text="Nhân viên đang làm việc" Foreground="#115E59"/><TextBlock x:Name="OnlineText" Text="0 người" FontSize="20" FontWeight="Bold" Foreground="#0F766E" Margin="0,6,0,0"/></StackPanel></Border>
                        <TextBlock x:Name="DashboardNote" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
