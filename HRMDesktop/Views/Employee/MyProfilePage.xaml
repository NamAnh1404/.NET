<Page x:Class="HRMDesktop.Views.Employee.MyProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28" MaxWidth="920" HorizontalAlignment="Stretch">
        <TextBlock Text="Hồ sơ cá nhân" Style="{StaticResource PageTitle}"/><TextBlock Text="Kiểm tra và cập nhật thông tin liên hệ của bạn." Style="{StaticResource PageSubtitle}"/>
        <Border Style="{StaticResource Card}" Margin="0,22,0,0" MaxWidth="820" HorizontalAlignment="Stretch"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="66" Height="66" Background="#DDF4F0" CornerRadius="33"><TextBlock x:Name="InitialText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ProfileNameText" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CodeDepartmentText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Grid>
            <Separator Margin="0,22" Background="{StaticResource BorderBrush}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,10,16"><TextBlock Text="Họ và tên" FontWeight="SemiBold"/><TextBox x:Name="FullNameBox" Style="{StaticResource Input}" Margin="0,7,0,0" IsReadOnly="True" ToolTip="Thông tin pháp lý do Admin quản lý"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,16"><TextBlock Text="Ngày sinh" FontWeight="SemiBold"/><DatePicker x:Name="BirthDatePicker" Margin="0,7,0,0" IsEnabled="False" ToolTip="Liên hệ Admin nếu cần điều chỉnh"/></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,10,16"><TextBlock Text="Email" FontWeight="SemiBold"/><TextBox x:Name="EmailBox" Style="{StaticResource Input}" Margin="0,7,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,16"><TextBlock Text="Số điện thoại" FontWeight="SemiBold"/><TextBox x:Name="PhoneBox" Style="{StaticResource Input}" Margin="0,7,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,10,0"><TextBlock Text="Phòng ban" FontWeight="SemiBold"/><TextBox x:Name="DepartmentBox" Style="{StaticResource Input}" Margin="0,7,0,0" IsReadOnly="True"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Chức vụ" FontWeight="SemiBold"/><TextBox x:Name="PositionBox" Style="{StaticResource Input}" Margin="0,7,0,0" IsReadOnly="True"/></StackPanel>
            </Grid>
            <TextBlock Text="Họ tên và ngày sinh là thông tin hồ sơ pháp lý. Hãy liên hệ Admin khi cần điều chỉnh." Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
            <Button Content="Lưu thông tin liên hệ" Style="{StaticResource PrimaryButton}" Width="175" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Save_Click"/>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</Page>
