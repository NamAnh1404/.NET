<Page x:Class="HRMDesktop.Views.Employee.MyLeavePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Nghỉ phép" Style="{StaticResource PageTitle}"/><TextBlock Text="Tạo đơn mới và theo dõi kết quả xử lý." Style="{StaticResource PageSubtitle}"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Loại nghỉ" FontWeight="SemiBold"/><ComboBox x:Name="LeaveTypeBox" Margin="0,7,10,0" SelectedIndex="0"><ComboBoxItem Content="Nghỉ phép năm"/><ComboBoxItem Content="Nghỉ ốm"/><ComboBoxItem Content="Nghỉ không lương"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Từ ngày" FontWeight="SemiBold"/><DatePicker x:Name="FromDatePicker" Margin="0,7,10,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Đến ngày" FontWeight="SemiBold"/><DatePicker x:Name="ToDatePicker" Margin="0,7,10,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Lý do" FontWeight="SemiBold"/><TextBox x:Name="ReasonBox" Style="{StaticResource Input}" Margin="0,7,10,0"/></StackPanel><Button Grid.Column="4" Content="Gửi đơn" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="38" Click="Submit_Click"/></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Danh sách đơn của tôi" FontSize="17" FontWeight="SemiBold"/><DataGrid x:Name="LeaveGrid" Margin="0,16,0,0"><DataGrid.Columns><DataGridTextColumn Header="LOẠI NGHỈ" Binding="{Binding LeaveType}" Width="135"/><DataGridTextColumn Header="THỜI GIAN" Binding="{Binding DateRange}" Width="175"/><DataGridTextColumn Header="NGÀY CÔNG" Binding="{Binding TotalDays}" Width="85"/><DataGridTextColumn Header="LÝ DO" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="110"/><DataGridTemplateColumn Header="THAO TÁC" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Hủy đơn" Style="{StaticResource SecondaryButton}" Padding="10,6" Tag="{Binding}" IsEnabled="{Binding CanCancel}" Click="CancelRequest_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
    </Grid>
</Page>
