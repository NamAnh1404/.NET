<Page x:Class="HRMDesktop.Views.Employee.MySalaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28">
        <TextBlock Text="Phiếu lương" Style="{StaticResource PageTitle}"/><TextBlock Text="Xem chi tiết thu nhập và khấu trừ theo tháng." Style="{StaticResource PageSubtitle}"/>
        <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Lương cơ bản" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BaseText" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Thưởng" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BonusText" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Khấu trừ" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DeductionText" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Thực nhận" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NetText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/></StackPanel></Border></Grid>
        <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><Grid><TextBlock Text="Chi tiết phiếu lương" FontSize="17" FontWeight="SemiBold"/><ComboBox x:Name="MonthBox" HorizontalAlignment="Right" Width="170" SelectionChanged="MonthBox_Changed"/></Grid><DataGrid x:Name="SalaryGrid" Height="285" Margin="0,16,0,0"><DataGrid.Columns><DataGridTextColumn Header="THÁNG" Binding="{Binding Month}" Width="0.7*"/><DataGridTextColumn Header="LƯƠNG CƠ BẢN" Binding="{Binding BaseSalaryDisplay}" Width="1.1*"/><DataGridTextColumn Header="THƯỞNG" Binding="{Binding BonusDisplay}" Width="0.9*"/><DataGridTextColumn Header="KHẤU TRỪ" Binding="{Binding DeductionDisplay}" Width="0.9*"/><DataGridTextColumn Header="THỰC NHẬN" Binding="{Binding NetSalaryDisplay}" Width="1.1*"/><DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="1*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
    </StackPanel>
</Page>
