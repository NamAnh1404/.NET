<Window x:Class="HRMDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - HRM Desktop" Height="600" Width="960"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#EEF3F7">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="58">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="HR" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="HRM Desktop" FontSize="34" FontWeight="SemiBold" Foreground="White" Margin="0,28,0,0"/>
                    <TextBlock Text="Quản lý nhân sự tập trung, rõ ràng và hiệu quả." FontSize="16" Foreground="#BAC8D8" TextWrapping="Wrap" Margin="0,13,50,0" LineHeight="25"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White">
            <Grid Margin="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đăng nhập" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Sử dụng tài khoản được cấp để tiếp tục." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,30"/>

                    <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="UsernameBox" Style="{StaticResource Input}" Height="44" Text="admin"/>
                    <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <PasswordBox x:Name="PasswordBox" Padding="11,8" Height="44" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Password="123" KeyDown="PasswordBox_KeyDown"/>
                    <TextBlock x:Name="ErrorText" Foreground="#DC2626" Margin="0,10,0,0" Visibility="Collapsed" Text="Tên đăng nhập hoặc mật khẩu không đúng."/>

                    <Button Content="Đăng nhập" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,24,0,0" Click="Login_Click"/>

                    <Border Background="#F1F5F9" CornerRadius="5" Padding="13" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Tài khoản dùng thử" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Admin: admin / 123" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Nhân viên: employee / 123" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
